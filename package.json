{
  "name": "tide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TIDE — a two-player, phone-controlled, music-driven fluid-football game.",
  "scripts": {
    "dev": "vite",
    "relay": "node relay/server.mjs",
    "wired": "node tools/wired/wired.mjs",
    "gen-track": "tsx tools/gen-track/gen.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vitest": "^2.1.1",
    "ws": "^8.18.0"
  }
}
